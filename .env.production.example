# Docker
APP_PORT=3101
DOCKER_NETWORK=fmr-watch-network
RUN_DB_MIGRATIONS=true

# Application
NEXT_PUBLIC_APP_URL=https://infrawatch.bafe.gov.ph
NEXT_PUBLIC_BASE_URL=https://infrawatch.bafe.gov.ph

# PostgreSQL on the shared production Docker network
DATABASE_URL=postgresql://infra_watch:replace-with-db-password@postgres18:5432/infra_watch
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_MAX_LIFETIME=1800
DRIZZLE_INCLUDE_AUTH=true

# Better Auth
BETTER_AUTH_URL=https://infrawatch.bafe.gov.ph
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret
EMAIL_OTP_EXPIRY=180

# Shared production MinIO, dedicated InfraWatch bucket
MINIO_ENDPOINT=storage.bafe.gov.ph
MINIO_PORT=443
MINIO_ACCESS_KEY=replace-with-production-access-key
MINIO_SECRET_KEY=replace-with-production-secret-key
MINIO_BUCKET_NAME=infra-watch
MINIO_USE_SSL=true
NEXT_PUBLIC_MINIO_ENDPOINT=storage.bafe.gov.ph
NEXT_PUBLIC_MINIO_BUCKET=infra-watch
NEXT_PUBLIC_MINIO_USE_SSL=true

# Upload and moderation limits
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=104857600
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
NSFW_IMAGE_MODERATION_ENABLED=true
NSFW_PORN_THRESHOLD=0.4
NSFW_HENTAI_THRESHOLD=0.4
NSFW_SEXY_THRESHOLD=0.25
NSFW_FAIL_CLOSED=true

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ABEMIS integration
ABEMIS_BASE_URL=https://abemis.bafe.gov.ph
ABEMIS_API_KEY=
ABEMIS_INFRA_ENDPOINT=/api/infra-amefip-list

# InfraWatch AI (keep credentials in .env.production or a secret manager)
AI_PROVIDER=google
AI_MODEL=gemini-flash-latest
GEMINI_API_KEY=replace-with-production-gemini-key

# Optional managerial dashboard copilot. Disabled unless explicitly set to true.
ENABLE_MANAGERIAL_AI=false
# ANIA — admin-only voice extension. Expose the sidecar only through the TLS reverse proxy.
VOICE_ASSISTANT_ENABLED=false
WAKE_WORD=hey_ania
WAKE_WORD_WS_URL=wss://infra-watch.bafe.gov.ph/voice/wake
WAKE_WORD_TOKEN_SECRET=replace-with-a-unique-random-secret
WAKE_WORD_MODEL_PATH=models/hey_ania.onnx
SLEEP_WORD_MODEL_PATH=models/anh_ya_sleep.onnx
WAKE_WORD_THRESHOLD=0.5
KOKORO_MODEL_PATH=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_VOICE=af_heart
# Run the local Whisper sidecar on the same host; never expose this endpoint publicly.
LOCAL_WHISPER_URL=http://127.0.0.1:8002/transcribe
LOCAL_WHISPER_TOKEN=replace-with-a-long-random-secret

# Public chatbot history, abuse controls, and trusted Nginx boundary
CHAT_HISTORY_RETENTION_DAYS=90
CHAT_REQUIRE_AUTH=false
# Required for anonymous production chat. The checked-in Nginx configuration
# replaces client-supplied forwarding headers before requests reach the app.
CHAT_TRUST_PROXY=true
CHAT_RATE_LIMIT_SECRET=replace-with-a-unique-random-secret
CHAT_RATE_LIMIT_PER_MINUTE=5
CHAT_GLOBAL_DAILY_LIMIT=2000
CHAT_RESPONSE_TIMEOUT_MS=55000
# One-time opt-in only for a verified existing schema without a Drizzle journal.
BASELINE_EXISTING_DATABASE=false

# Scheduler
ENABLE_SCHEDULER=true
SYNC_CRON_SCHEDULE=0 2 * * *

# Initial administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
