# Docker
APP_PORT=3101
DOCKER_NETWORK=fmr-watch-network
RUN_DB_MIGRATIONS=true

# Application
NEXT_PUBLIC_APP_URL=https://infrawatch.bafe.gov.ph
NEXT_PUBLIC_BASE_URL=https://infrawatch.bafe.gov.ph

# PostgreSQL on the shared production Docker network
DATABASE_URL=postgresql://infra_watch:replace-with-db-password@postgres18:5432/infra_watch
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_MAX_LIFETIME=1800
DRIZZLE_INCLUDE_AUTH=true

# Better Auth
BETTER_AUTH_URL=https://infrawatch.bafe.gov.ph
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret
EMAIL_OTP_EXPIRY=180

# Shared production MinIO, dedicated InfraWatch bucket
MINIO_ENDPOINT=storage.bafe.online
MINIO_PORT=443
MINIO_ACCESS_KEY=replace-with-production-access-key
MINIO_SECRET_KEY=replace-with-production-secret-key
MINIO_BUCKET_NAME=infra-watch
MINIO_USE_SSL=true
NEXT_PUBLIC_MINIO_ENDPOINT=storage.bafe.online
NEXT_PUBLIC_MINIO_BUCKET=infra-watch
NEXT_PUBLIC_MINIO_USE_SSL=true

# Upload and moderation limits
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=104857600
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
NSFW_IMAGE_MODERATION_ENABLED=true
NSFW_PORN_THRESHOLD=0.4
NSFW_HENTAI_THRESHOLD=0.4
NSFW_SEXY_THRESHOLD=0.25
NSFW_FAIL_CLOSED=true

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ABEMIS integration
ABEMIS_BASE_URL=https://abemis.bafe.gov.ph
ABEMIS_API_KEY=
ABEMIS_INFRA_ENDPOINT=/api/infra-list

# Scheduler
ENABLE_SCHEDULER=true
SYNC_CRON_SCHEDULE=0 2 * * *

# Initial administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
