# Application
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/infra_watch
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_MAX_LIFETIME=1800

# Better Auth
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-minio-secret
MINIO_BUCKET_NAME=infra-watch
MINIO_USE_SSL=false
NEXT_PUBLIC_MINIO_ENDPOINT=localhost:9000
NEXT_PUBLIC_MINIO_BUCKET=infra-watch
NEXT_PUBLIC_MINIO_USE_SSL=false
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=104857600
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
NSFW_IMAGE_MODERATION_ENABLED=true
NSFW_PORN_THRESHOLD=0.4
NSFW_HENTAI_THRESHOLD=0.4
NSFW_SEXY_THRESHOLD=0.25
NSFW_FAIL_CLOSED=true
EMAIL_OTP_EXPIRY=180

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ABEMIS integration
ABEMIS_BASE_URL=https://abemis.bafe.gov.ph
ABEMIS_API_KEY=
ABEMIS_INFRA_ENDPOINT=/api/infra-amefip-list

# Scheduler Configuration
ENABLE_SCHEDULER=true
SYNC_CRON_SCHEDULE="0 2 * * *"

# AI Chatbot — pick a provider and set the matching API key
# AI_PROVIDER options: google | openai | anthropic | kimi
AI_PROVIDER=google
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
# Optional managerial dashboard copilot. Disabled unless explicitly set to true.
ENABLE_MANAGERIAL_AI=false
# ANIA — admin-only voice extension. Keep disabled until the wake-word sidecar is deployed.
VOICE_ASSISTANT_ENABLED=false
WAKE_WORD=hey_ania
WAKE_WORD_WS_URL=ws://localhost:8000/wake
WAKE_WORD_TOKEN_SECRET=replace-with-a-long-random-secret
WAKE_WORD_MODEL_PATH=models/hey_ania.onnx
SLEEP_WORD_MODEL_PATH=models/anh_ya_sleep.onnx
WAKE_WORD_THRESHOLD=0.5
KOKORO_MODEL_PATH=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_VOICE=af_heart
# Local open-source Whisper sidecar. Keep the URL loopback-only and the token server-side.
LOCAL_WHISPER_URL=http://127.0.0.1:8002/transcribe
LOCAL_WHISPER_TOKEN=replace-with-a-long-random-secret
CHAT_HISTORY_RETENTION_DAYS=90
CHAT_REQUIRE_AUTH=true
# Required for anonymous chat in production. Enable only when the trusted edge
# replaces client-supplied forwarding headers with the canonical client IP.
CHAT_TRUST_PROXY=false
CHAT_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
CHAT_RATE_LIMIT_PER_MINUTE=5
CHAT_GLOBAL_DAILY_LIMIT=2000
CHAT_RESPONSE_TIMEOUT_MS=55000
# One-time opt-in only for an existing database that predates the Drizzle journal.
BASELINE_EXISTING_DATABASE=false

# Optional default administrator seed flow for later phases
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
