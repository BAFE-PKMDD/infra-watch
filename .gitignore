# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]
/nul

# debug
/output/playwright/
/.playwright-cli/
/.dev-logs/
npm-debug.log*
.dev-server*.log
dev-server*.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev-tools
/dev-tools/

# local source GIS files (commit only generated runtime boundaries)
/Political Boundaries/

# generated during the application build
/public/ania/tts-worker.js

# local Hermes agent artifacts
/.hermes/
/skills-lock.json

