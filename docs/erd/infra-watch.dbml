Ref account_user_id_user_id_fk: "account".user_id > "user".id [delete: cascade]
Ref articles_project_id_projects_abemis_id_fk: "articles".project_id > "projects".abemis_id [delete: set null]
Ref contact_responses_message_id_contact_messages_id_fk: "contact_responses".message_id > "contact_messages".id [delete: cascade]
